+// Synchronized diagnostic frame:
+//   [primary: 640 int16] [ref: 640 int16] [clean: 640 int16]
+static bool ws_send_all(WiFiClient &client, const audio_stream_packet_t &pkt) {
+    if (!client || !client.connected()) return false;
+
+    uint8_t packet[4 + ALL_STREAM_BYTES];
+    const size_t payload_len = ALL_STREAM_BYTES;
+    size_t header_len = 0;
+
+    packet[0] = 0x82; // FIN + Binary Frame opcode
+    packet[1] = 126;  // 16-bit extended payload length
+    packet[2] = (uint8_t)((payload_len >> 8) & 0xFF);
+    packet[3] = (uint8_t)(payload_len & 0xFF);
+    header_len = 4;
+
+    size_t off = header_len;
+    memcpy(packet + off, pkt.primary, BATCH_SAMPLES * sizeof(int16_t));
+    off += BATCH_SAMPLES * sizeof(int16_t);
+    memcpy(packet + off, pkt.ref, BATCH_SAMPLES * sizeof(int16_t));
+    off += BATCH_SAMPLES * sizeof(int16_t);
+    memcpy(packet + off, pkt.clean, BATCH_SAMPLES * sizeof(int16_t));
+
+    return (client.write(packet, header_len + payload_len) ==
+            header_len + payload_len);
+}
